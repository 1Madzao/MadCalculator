<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MadButton.Number" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:hapticFeedbackEnabled">false</item>
        <item name="backgroundTint">@color/glass_btn_number</item>
        <item name="strokeColor">@color/glass_stroke_subtle</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="rippleColor">@color/glass_ripple</item>
    </style>

    <style name="MadButton.Operator" parent="MadButton.Number">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_operator</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@color/glass_btn_operator</item>
        <item name="strokeColor">@color/glass_stroke_accent</item>
    </style>

    <style name="MadButton.Scientific" parent="MadButton.Number">
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@color/glass_btn_scientific</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="MadButton.Clear" parent="MadButton.Number">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_clear</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@color/glass_btn_clear</item>
    </style>

    <style name="MadButton.Equals" parent="MadButton.Number">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@color/glass_btn_equals</item>
        <item name="strokeColor">@color/glass_stroke_light</item>
    </style>
</resources>
